{
  "manifest_version": 3,
  "name": "Postulo",
  "version": "0.1.0",
  "description": "Send the job posting you are looking at to your own Postulo, for review. Nothing goes anywhere else.",
  "homepage_url": "https://source.tiagoagueda.com/postulo/postulo",
  "icons": {
    "16": "icons/postulo-16.png",
    "32": "icons/postulo-32.png",
    "48": "icons/postulo-48.png",
    "96": "icons/postulo-96.png",
    "128": "icons/postulo-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Capture this posting in Postulo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/postulo-16.png",
      "32": "icons/postulo-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture this posting in Postulo"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "postulo@tiagoagueda.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
